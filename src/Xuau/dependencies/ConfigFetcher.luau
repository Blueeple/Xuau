--!strict
--!native
--!optimize 2

-- Types
export type XuauToml = {
	Xuau: {
		path: string,
		useTOML_Config: boolean,
		binPath: string,
	},
	Settings: { [string]: any },
	Extentions: { [string]: string },
} & { [string]: any }

-- Modules
local Debugger = require("../core/Debugger")
local LRT_Detector = require("./LRT-Detector")
local LuneTransulator = require("./LuneTransulator")

-- Variables
local stockConfig = [[
# Generated by Xuau
# This file lists tools managed for Xuau and engine path.
# Xuau settings
[Xuau]
path = "src/Xuau/"
useTOML_Config = true
binPath = "."
#PreferedRuntime = "lute"
ForceDisableDebugOutput = false

# Xuau extentions
[Extentions]

]]
local isLoaded = false
local funcsToRun = {} :: { (...any) -> () }

-- External runtime implementation
if not LRT_Detector.isRoblox() then
	-- Lune Modules
	local fs = LuneTransulator.getFileSystem()
	local serde = LuneTransulator.getSerde()

	-- Variables
	local XuauEnginePath = "./"
	local isConfigModeInternal = false
	local XuauJson = nil
	local XuauToml = nil
	local XuauConfig_Json: { [string]: any }
	local XuauConfig_Toml: XuauToml

	-- Functions
	local getXuauConfig_json = function() -- check if the path actually makes sense, and update if such
		if not XuauJson and not isConfigModeInternal then
			if XuauToml then
				XuauEnginePath = XuauConfig_Toml.Xuau.path
				-- checks if the default path is correct
				if fs.isDir(XuauEnginePath) then
					local JsonFile = fs.readFile(`{XuauEnginePath}/config/XuauConfig.json`)
					XuauConfig_Json = serde.decode("json", JsonFile) :: any
				else
					error("Xuau directory cannot be found, Check for the correct path in 'Xuau.toml'")
				end
			end
		elseif not XuauJson and isConfigModeInternal then
		    XuauConfig_Json = XuauConfig_Toml.Xuau

		end

		isLoaded = true
		for _, func in funcsToRun do
			func()
		end
	end

	local getXuau_app = function()
		XuauToml = fs.isFile("./Xuau.toml")
		if XuauToml then
			Debugger.Out("Found Xuau.toml, reading...")
			local XuauToml_File = fs.readFile("./Xuau.toml")
			XuauConfig_Toml = serde.decode("toml", XuauToml_File) :: XuauToml

			if XuauConfig_Toml.Xuau.useTOML_Config == true then
				Debugger.Out("Xuau.toml 'useTOML_Config' is enabled.")
				isConfigModeInternal = true
			end
		else
			Debugger.Out("No Xuau.toml found, creating one.")
			fs.writeFile("./Xuau.toml", stockConfig)
			local XuauToml_File = fs.readFile("./Xuau.toml")
			XuauConfig_Toml = serde.decode("toml", XuauToml_File) :: XuauToml
			if XuauConfig_Toml.Xuau.useTOML_Config == true then
				Debugger.Out("Xuau.toml 'useTOML_Config' is enabled.")
				isConfigModeInternal = true
			end
		end
	end

	return {
		--[[
			Loads the configurations for Xuau.
		]]
		load = function()
			-- onLoad
			getXuau_app()
			getXuauConfig_json()
		end,
		--[[
		    Executes the function binded to the onLoad function.
		]]
		onLoad = function(func: (...any) -> ())
			table.insert(funcsToRun, func)
		end,
		--[[
            Returns the full Json config for Xuau.
        ]]
		getConfigJson_Full = function()
			if not isLoaded then
				Debugger.Warn("Xuau's configurations not loaded in time.")
			end
			return XuauConfig_Json
		end,
		--[[
            Returns the full toml config for Xuau.
        ]]
		getConfigToml_Full = function()
			if not isLoaded then
				Debugger.Warn("Xuau's configurations not loaded in time.")
			end
			return XuauConfig_Json
		end,
		--[[
            Returns the a value from the Json config for Xuau.
        ]]
		getConfig_Json = function(Name: string): any
			if not isLoaded then
				Debugger.Warn("Xuau's configurations not loaded in time.")
			end
			if XuauConfig_Json[Name] then
				return XuauConfig_Json[Name]
			end
			return
		end,
		--[[
            Returns the a value from the tonl config for Xuau.
        ]]
		getConfig_Toml = function(Name: string): any
			if not isLoaded then
				Debugger.Warn("Xuau's configurations not loaded in time.")
			end
			local XuauConfig = XuauConfig_Toml.Xuau :: { [string]: any }
			if XuauConfig[Name] then
				return XuauConfig[Name]
			end
			return
		end,
	}
end

-- Roblox implementation
local path = "../config/XuauConfig"
local _XuauConfig = require(path) :: { [string]: any }
return {
	--[[
		Loads the configurations for Xuau.
	]]
	load = function()
		Debugger.Warn("The 'Load' function is not needed in Roblox, Consider removing it.")
		return
	end,
	--[[
	    Executes the function binded to the onLoad function.
	]]
	onLoad = function(func: (...any) -> ())
		table.insert(funcsToRun, func)
	end,
	--[[
        Returns the full Json config for Xuau.
    ]]
	getConfigJson_Full = function()
		return {} :: any
	end,
	--[[
        Returns the full toml config for Xuau.
    ]]
	getConfigToml_Full = function()
		return {} :: any
	end,
	--[[
        Returns the a value from the Json config for Xuau.
    ]]
	getConfig_Json = function(Name: string): any
		return ""
	end,
	--[[
        Returns the a value from the tonl config for Xuau.
    ]]
	getConfig_Toml = function(Name: string): any
		return ""
	end,
}
